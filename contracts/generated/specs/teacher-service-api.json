{
  "components": {
    "schemas": {
      "StudentLearningState": {
        "properties": {
          "className": {
            "type": "string"
          },
          "completedResourceIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "endedCount": {
            "type": "number"
          },
          "lastActiveAt": {
            "type": "number"
          },
          "learnedLessons": {
            "type": "number"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "progress": {
            "type": "number"
          },
          "sessionCount": {
            "type": "number"
          },
          "stars": {
            "type": "number"
          },
          "status": {
            "enum": [
              "not-started",
              "learning",
              "completed",
              "needs-attention"
            ],
            "type": "string"
          },
          "studentId": {
            "minLength": 1,
            "type": "string"
          },
          "studentNumber": {
            "type": "string"
          },
          "totalLessons": {
            "type": "number"
          }
        },
        "required": [
          "studentId",
          "name",
          "status"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "platformServiceKey": {
        "in": "header",
        "name": "X-Platform-Service-Key",
        "type": "apiKey"
      },
      "platformSubject": {
        "in": "header",
        "name": "X-Platform-Subject",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Platform-to-teacher service calls. Publication verdict is additive and does not switch existing platform reads.",
    "title": "Teacher Service API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/classes/{courseId}/students": {
      "put": {
        "operationId": "updateTeacherStudentState",
        "parameters": [
          {
            "in": "path",
            "name": "courseId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentLearningState"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "student": {
                      "$ref": "#/components/schemas/StudentLearningState"
                    },
                    "studentCount": {
                      "type": "integer"
                    },
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "student",
                    "studentCount"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Upserted student state. Do not double-run real learning events for shadow comparison."
          },
          "400": {
            "description": "Invalid student state"
          },
          "401": {
            "description": "Invalid delegated identity"
          },
          "403": {
            "description": "Invalid service key or ownership"
          },
          "404": {
            "description": "Active course not found"
          },
          "503": {
            "description": "Platform authorization unavailable"
          }
        },
        "security": [
          {
            "platformServiceKey": [],
            "platformSubject": []
          }
        ]
      }
    },
    "/api/course-space": {
      "post": {
        "description": "Platform provisioning profile. The stable course id is required here to preserve idempotency; the general teacher UI supports additional fields.",
        "operationId": "provisionTeacherCourse",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "title"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "course": {
                      "additionalProperties": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "type": "object"
                    },
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "course"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Existing course (idempotent provisioning)."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "course": {
                      "additionalProperties": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "type": "object"
                    },
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "course"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Newly provisioned course."
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid delegated identity"
          },
          "403": {
            "description": "Invalid service key or ownership"
          },
          "409": {
            "description": "Course ownership conflict"
          },
          "502": {
            "description": "Platform registration unavailable"
          },
          "503": {
            "description": "Platform authorization or course storage unavailable"
          }
        },
        "security": [
          {
            "platformServiceKey": [],
            "platformSubject": []
          }
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getTeacherServiceHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "capabilities": {
                      "additionalProperties": true,
                      "type": "object"
                    },
                    "status": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "status",
                    "version",
                    "capabilities"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Service response; HTTP 200 alone does not prove database readiness."
          }
        },
        "security": []
      }
    },
    "/api/internal/platform/courses/{courseId}/publication": {
      "get": {
        "description": "A negative verdict includes inactive courses and withdrawn knowledge packages. The platform remains responsible for enrollment and identity checks.",
        "operationId": "getTeacherPublicationVerdict",
        "parameters": [
          {
            "in": "path",
            "name": "courseId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "publication": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "properties": {
                            "publicationId": {
                              "type": "string"
                            },
                            "version": {
                              "type": "integer"
                            }
                          },
                          "required": [
                            "publicationId",
                            "version"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "published": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "published",
                    "publication"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Current teacher publication verdict"
          },
          "401": {
            "description": "Invalid delegated identity"
          },
          "403": {
            "description": "Service delegation missing or denied"
          },
          "503": {
            "description": "Platform authorization or course storage unavailable"
          }
        },
        "security": [
          {
            "platformServiceKey": [],
            "platformSubject": []
          }
        ],
        "summary": "Resolve the teacher-owned current publication for a platform course alias"
      }
    },
    "/api/internal/platform/courses/{courseId}/publication-counts": {
      "get": {
        "description": "Counts published artifacts with a classroom ID, including archived course history, matching the platform's existing analytics queries.",
        "operationId": "getTeacherPublicationCounts",
        "parameters": [
          {
            "in": "path",
            "name": "courseId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "distinctClassrooms": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "publishedArtifactsWithClassroom": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "distinctClassrooms",
                    "publishedArtifactsWithClassroom"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Counts under the course"
          },
          "403": {
            "description": "Invalid service delegation"
          },
          "404": {
            "description": "Teacher course not found"
          },
          "503": {
            "description": "Teacher storage unavailable"
          }
        },
        "security": [
          {
            "platformServiceKey": [],
            "platformSubject": []
          }
        ],
        "summary": "Teacher-owned published classroom and artifact counts"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3200"
    }
  ]
}
