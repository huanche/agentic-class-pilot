{
  "components": {
    "schemas": {},
    "securitySchemes": {
      "studentServiceKey": {
        "in": "header",
        "name": "X-Student-Service-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Platform-to-student backend operations owned by the student service.",
    "title": "Student Service API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/internal/platform/courses/{course_id}/learning-data": {
      "post": {
        "operationId": "getStudentCourseLearningData",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "userIds": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 10000,
                    "type": "array"
                  }
                },
                "required": [
                  "userIds"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "eventSummary": {
                      "additionalProperties": {
                        "type": "integer"
                      },
                      "type": "object"
                    },
                    "mastery": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "sessions": {
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "sessions",
                    "mastery",
                    "eventSummary"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Bounded sessions, mastery rows and event counts for the supplied users"
          },
          "403": {
            "description": "Invalid service credentials"
          },
          "503": {
            "description": "Student data unavailable"
          }
        },
        "security": [
          {
            "studentServiceKey": []
          }
        ],
        "summary": "Bounded student-owned rows for an authorized platform course view"
      }
    },
    "/api/internal/platform/courses/{course_id}/users/{user_id}/progress": {
      "get": {
        "operationId": "getStudentCourseProgress",
        "parameters": [
          {
            "in": "path",
            "name": "course_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "user_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "endedSessions": {
                      "type": "integer"
                    },
                    "lastActiveAt": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "learnedLessons": {
                      "type": "integer"
                    },
                    "sessionCount": {
                      "type": "integer"
                    },
                    "stars": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "learnedLessons",
                    "lastActiveAt",
                    "sessionCount",
                    "endedSessions",
                    "stars"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Raw student-owned progress metrics without teacher publication count"
          },
          "403": {
            "description": "Invalid service credentials"
          },
          "503": {
            "description": "Student data unavailable"
          }
        },
        "security": [
          {
            "studentServiceKey": []
          }
        ],
        "summary": "Student-owned metrics for one user in one course"
      }
    },
    "/api/internal/platform/published-lesson-knowledge": {
      "post": {
        "description": "The platform verifies publication and supplies the teacher-owned snapshot; the student service owns the durable job table.",
        "operationId": "enqueuePublishedLessonKnowledgeAtStudent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "classroomId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "courseId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "lessonId": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "scenes": {
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 1000,
                    "type": "array"
                  },
                  "videoRevision": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "courseId",
                  "lessonId",
                  "videoRevision",
                  "classroomId",
                  "scenes"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "courseId": {
                      "type": "string"
                    },
                    "lessonId": {
                      "type": "string"
                    },
                    "videoRevision": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "courseId",
                    "lessonId",
                    "videoRevision"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Queued or already present"
          },
          "403": {
            "description": "Invalid service credentials"
          },
          "503": {
            "description": "Student job storage unavailable"
          }
        },
        "security": [
          {
            "studentServiceKey": []
          }
        ],
        "summary": "Idempotently queue preparation for one verified published lesson revision"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8001"
    }
  ]
}
