#!/usr/bin/python3
"""Deploy a verified two-app release without mutating the shared repository or runtime data."""
import fcntl
import json
import os
from pathlib import Path
import re
import signal
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

BASE = Path('/opt/agentic-mainland-web')
OLD = Path('/opt/agentic-class-pilot')
UV = '/home/ubuntu/.local/bin/uv'
REPO = 'ccr.ccs.tencentyun.com/agentedu-mainland/agentic-teacher'
UNITS = ('agentic-platform', 'agentic-student')
FROZEN = Path('/run/agentic-web-migration')


def call(args, **kwargs):
    timeout = kwargs.pop('timeout', None)
    if timeout is None or args[:5] != ['runuser', '-u', 'ubuntu', '--', UV]:
        return subprocess.run(args, check=True, timeout=timeout, **kwargs)
    return _call_process_group(args, timeout=timeout, **kwargs)


def _call_process_group(args, timeout, **kwargs):
    # runuser can leave uv running after its own process is killed. Keep the
    # whole command in one process group so a timed-out install releases SSH.
    process = subprocess.Popen(args, start_new_session=True, **kwargs)
    try:
        returncode = process.wait(timeout=timeout)
    except BaseException:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=30)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
        raise
    if returncode:
        raise subprocess.CalledProcessError(returncode, args)
    return subprocess.CompletedProcess(args, returncode)


def output(args, **kwargs):
    return subprocess.check_output(args, **kwargs).decode().strip()


def live_environment(unit):
    pid = output(['systemctl', 'show', unit, '-p', 'MainPID', '--value'])
    if pid == '0':
        values = stopped_environment(unit)
    else:
        values = dict(p.decode().split('=', 1) for p in Path('/proc/' + pid + '/environ').read_bytes().split(b'\0') if b'=' in p)
    values.update(HOME='/home/ubuntu', UV_PYTHON_DOWNLOADS='never', UV_LINK_MODE='copy')
    return values



def release_environment(unit):
    """Validate the intended shared auth config before restarting existing writers."""
    values = live_environment(unit)
    path = Path('/etc/agentic-class-pilot/student-learning-auth.env')
    if not path.exists():
        return values
    stat = path.stat()
    if path.is_symlink() or stat.st_uid != 0 or stat.st_mode & 0o777 != 0o600:
        raise RuntimeError('Untrusted classroom service configuration')
    allowed = {'PLATFORM_TO_STUDENT_KEY', 'STUDENT_URL', 'PLATFORM_AUTH_URL',
               'STUDENT_COMMAND_TIMEOUT_SECONDS'}
    additions = {}
    for line in path.read_text().splitlines():
        if not line or line.startswith('#'):
            continue
        name, separator, value = line.partition('=')
        if not separator or name not in allowed or not value or name in additions:
            raise RuntimeError('Invalid classroom service configuration')
        additions[name] = value
    if len(additions.get('PLATFORM_TO_STUDENT_KEY', '')) < 64:
        raise RuntimeError('Classroom service key is missing or too short')
    return values | additions


def stopped_environment(unit):
    current = (BASE / 'current').resolve()
    path = FROZEN / (unit + '.json')
    try:
        return frozen_environment(path, str(current))
    except RuntimeError:
        # A failed first start can leave current pointing at the new code while
        # both writers remain stopped. Its root-owned receipt binds the original
        # environment, allowing a compatible repair without restarting old code.
        receipt = Path('/var/lib/agentic-class-pilot/staged-web') / (current.name + '.json')
        data = json.loads(receipt.read_text())
        reference = data.get('reference', '')
        if (data.get('sha') != current.name or not staged_release_matches(receipt, current, data)
                or not isinstance(reference, str)
                or not (reference.startswith(str(BASE / 'releases') + '/') or reference == str(OLD))):
            raise RuntimeError('Cannot verify the previous environment after failed activation') from None
        return frozen_environment(path, reference)


def frozen_environment(path, reference):
    stat = path.stat()
    if path.is_symlink() or stat.st_uid != 0 or stat.st_mode & 0o777 != 0o600:
        raise RuntimeError('Untrusted frozen environment')
    data = json.loads(path.read_text())
    if data['reference'] != reference or not isinstance(data['environment'], dict) or not all(
            isinstance(k, str) and isinstance(v, str) for k, v in data['environment'].items()):
        raise RuntimeError('Frozen environment does not match the previous release')
    return data['environment']


def capture_migration_environment():
    # Explicit root-only maintenance operation, never reachable via the CI SHA protocol.
    assert all(output(['systemctl', 'show', u, '-p', 'MainPID', '--value']) != '0' for u in UNITS)
    FROZEN.mkdir(mode=0o700, exist_ok=True)
    assert not FROZEN.is_symlink() and FROZEN.stat().st_uid == 0 and FROZEN.stat().st_mode & 0o777 == 0o700
    for unit in UNITS:
        path = FROZEN / (unit + '.json')
        # Exclusive create prevents overwriting a previous maintenance window or following a symlink.
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as file:
            json.dump({'reference': str((BASE / 'current').resolve()), 'environment': live_environment(unit)}, file)
    print('MIGRATION_ENVIRONMENT_CAPTURED; secrets remain in root-only /run files', flush=True)


def healthy():
    urls = ('http://127.0.0.1:8080/api/v1/utils/health-check/', 'http://127.0.0.1:8000/api/session/ready')
    for _ in range(40):
        try:
            for url in urls:
                with urllib.request.urlopen(url, timeout=3) as response:
                    assert response.status == 200
            return True
        except Exception:
            time.sleep(2)
    return False


def atomic_text(path, text):
    tmp = path.with_suffix('.new')
    tmp.write_text(text)
    tmp.chmod(0o644)
    tmp.replace(path)


def rollback_compatible(reference, release):
    try:
        filename = 'student_agent/RELEASE_COMPATIBILITY.json'
        previous = json.loads((reference / filename).read_text())
        target = json.loads((release / filename).read_text())
        return previous['studentDataFormat'] == target['studentDataFormat'] == 'student-reliable-records-v1'
    except (OSError, ValueError, KeyError, TypeError):
        return False


def staged_release_matches(receipt, release, expected):
    try:
        return (not release.is_symlink() and not receipt.is_symlink()
                and receipt.stat().st_uid == 0 and receipt.stat().st_mode & 0o777 == 0o600
                and json.loads(receipt.read_text()) == expected
                and json.loads((release / 'manifest.json').read_text())['sha'] == expected['sha'])
    except (OSError, ValueError, KeyError, TypeError):
        return False


def recover(restore, stop, compatible):
    # The migration/backfill has already happened even if start failed early.
    # Resuming a pre-P2 writer would leave authoritative snapshots stale.
    if not compatible:
        stop()
        raise RuntimeError('UNSAFE_CODE_ROLLBACK_BLOCKED: services stopped; keep maintenance closed and recover with a compatible release; do not downgrade or restore over new records')
    restore()


def deploy():
    assert os.geteuid() == 0 and output(['hostname']) == 'VM-0-4-ubuntu'
    os.umask(0o022)  # Source releases must be traversable by the service user; no secrets are stored here.
    if sys.argv[1:] == ['--capture-migration-environment']:
        capture_migration_environment()
        return
    stage_only = len(sys.argv) == 3 and sys.argv[1] == '--stage-only'
    sha = sys.argv[2] if stage_only else (sys.argv[1] if len(sys.argv) == 2 else '')
    if not re.fullmatch('[0-9a-f]{40}', sha):
        raise RuntimeError('Invalid commit')
    flag = Path('/etc/agentic-class-pilot/web-deploy-enabled')
    assert flag.is_file() and flag.stat().st_uid == 0 and flag.stat().st_mode & 0o777 == 0o600
    fd = os.open('/run/lock/agentic-teacher-deploy.lock', os.O_CREAT | os.O_WRONLY, 0o600)
    if fd != 9:
        os.dup2(fd, 9)
        os.close(fd)
    os.set_inheritable(9, True)
    fcntl.flock(9, fcntl.LOCK_EX)
    tag = 'web-' + sha
    record = Path('/var/lib/agentic-class-pilot/prepared-images') / (tag + '.json')
    assert record.stat().st_uid == 0 and record.stat().st_mode & 0o022 == 0
    metadata = json.loads(record.read_text())
    assert metadata['image'] == REPO + ':' + tag
    assert output(['docker', 'image', 'inspect', '-f', '{{.Id}}', metadata['image']]) == metadata['id']
    BASE.mkdir(mode=0o755, exist_ok=True)
    (BASE / 'releases').mkdir(mode=0o755, exist_ok=True)
    current = BASE / 'current'
    release = BASE / 'releases' / sha
    if current.is_symlink() and current.resolve() == release and healthy():
        assert output(['systemctl', 'show', UNITS[0], '-p', 'WorkingDirectory', '--value']) == str(release / 'platform/backend')
        assert output(['systemctl', 'show', UNITS[1], '-p', 'WorkingDirectory', '--value']) == str(release / 'student_agent')
        print('WEB_ALREADY_CURRENT', sha, flush=True)
        return
    # Capture the old service env before switching. No credentials enter the release image.
    env_platform = release_environment(UNITS[0])
    env_student = release_environment(UNITS[1])
    reference = current.resolve() if current.is_symlink() else OLD
    platform = release / 'platform'
    student = release / 'student_agent'
    receipts = Path('/var/lib/agentic-class-pilot/staged-web')
    receipts.mkdir(mode=0o700, exist_ok=True)
    assert not receipts.is_symlink() and receipts.stat().st_uid == 0 and receipts.stat().st_mode & 0o777 == 0o700
    receipt = receipts / (sha + '.json')
    expected = {'sha': sha, 'image_id': metadata['id'], 'reference': str(reference)}
    if release.exists():
        if not staged_release_matches(receipt, release, expected):
            raise RuntimeError('Incomplete/unverified existing release; inspect before retrying')
        print('VERIFIED_STAGED_RELEASE_REUSED', sha, flush=True)
    else:
        release.mkdir(mode=0o755, parents=True)
        container = 'agentic-web-extract-' + sha[:12]
        call(['docker', 'create', '--name', container, '--entrypoint', '/unused', metadata['id']], stdout=subprocess.DEVNULL)
        try:
            with tempfile.TemporaryFile() as archive:
                call(['docker', 'cp', container + ':/release/.', '-'], stdout=archive)
                archive.seek(0)
                with tarfile.open(fileobj=archive) as tar:
                    tar.extractall(release, filter='data')
        finally:
            call(['docker', 'rm', container], stdout=subprocess.DEVNULL)
        assert json.loads((release / 'manifest.json').read_text())['sha'] == sha
        for path in ('platform/backend/app/frontend/index.html', 'student_agent/frontend/out/index.html'):
            assert (release / path).is_file(), path
        # Runtime is persistent and is never copied into a code release.
        runtime = release / 'student_agent/runtime'
        if runtime.exists():
            raise RuntimeError('Release must not contain persisted runtime')
        runtime.symlink_to(OLD / 'student_agent/runtime', target_is_directory=True)
        # Dependency builders run as ubuntu, never as root. Runtime requirements are pinned by source lock/requirements.
        call(['chown', '-R', 'ubuntu:ubuntu', str(release)])
        platform = release / 'platform'
        student = release / 'student_agent'
        def clone_environment(app, files, old_venv, env):
            unchanged = all((reference / app / f).read_bytes() == (release / app / f).read_bytes() for f in files)
            if not old_venv.is_dir():
                return False
            target = release / app / '.venv'
            shutil.copytree(old_venv, target, symlinks=True)
            # Editable install paths must follow the versioned code, never the old checkout.
            for pth in target.glob('lib/python*/site-packages/*.pth'):
                text = pth.read_text()
                pth.write_text(text.replace(str(reference / app), str(release / app)))
            call(['chown', '-R', 'ubuntu:ubuntu', str(target)])
            if unchanged:
                call(['runuser', '-u', 'ubuntu', '--', UV, 'pip', 'check', '--python', str(target / 'bin/python')],
                     cwd=release / app, env=env, timeout=60)
                print('DEPENDENCIES_REUSED_WITH_IDENTICAL_METADATA', app, flush=True)
            else:
                print('DEPENDENCIES_COPIED_FOR_INCREMENTAL_INSTALL', app, flush=True)
            return unchanged
        platform_same = clone_environment('platform', ['uv.lock', 'pyproject.toml', 'backend/pyproject.toml'],
                                          reference / 'platform/.venv', env_platform)
        if not platform_same:
            print('PLATFORM_DEPENDENCY_SYNC_STARTED', flush=True)
            call(['runuser', '-u', 'ubuntu', '--', UV, 'sync', '--frozen', '--no-dev', '--package', 'app',
                  '--python', str((platform / '.venv/bin/python') if (platform / '.venv').is_dir()
                                  else (OLD / 'platform/.venv/bin/python'))],
                 cwd=platform, env=env_platform, timeout=900)
        student_venv = reference / ('student_agent/.venv-migrate' if reference == OLD else 'student_agent/.venv')
        student_same = clone_environment('student_agent', ['backend/requirements.txt'], student_venv, env_student)
        if not student_same:
            if not (student / '.venv').is_dir():
                call(['runuser', '-u', 'ubuntu', '--', UV, 'venv', str(student / '.venv'), '--python',
                      str(OLD / 'student_agent/.venv-migrate/bin/python')], cwd=student, env=env_student, timeout=60)
            print('STUDENT_DEPENDENCY_INSTALL_STARTED', flush=True)
            call(['runuser', '-u', 'ubuntu', '--', UV, 'pip', 'install', '--python', str(student / '.venv/bin/python'),
                  '-r', str(student / 'backend/requirements.txt')], cwd=student, env=env_student, timeout=900)
            call(['runuser', '-u', 'ubuntu', '--', UV, 'pip', 'check', '--python', str(student / '.venv/bin/python')],
                 cwd=student, env=env_student, timeout=60)
        fd = os.open(receipt, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'w') as file:
            json.dump(expected, file)
    if stage_only:
        print('WEB_STAGED_ONLY; no migration, backup, stop or service switch performed', sha, flush=True)
        return
    python = str(platform / '.venv/bin/python')
    def revisions(which):
        return output(['runuser', '-u', 'ubuntu', '--', python, '-m', 'alembic', which],
                      cwd=platform / 'backend', env=env_platform)
    # Reject automatic data-format changes: code rollback cannot undo a schema migration.
    current_revision = revisions('current')
    target_revision = revisions('heads')
    if sorted(line.split()[0] for line in current_revision.splitlines() if line.strip()) != sorted(line.split()[0] for line in target_revision.splitlines() if line.strip()):
        raise RuntimeError('Database migration requires separate reviewed execution; active services untouched')
    # Run with the actual restricted student role, not the migration owner.
    call(['runuser', '-u', 'ubuntu', '--', str(student / '.venv/bin/python'),
          '-m', 'backend.infrastructure.release_check'], cwd=student, env=env_student, timeout=30)
    compatible = rollback_compatible(reference, release)
    if not compatible and any(output(['systemctl', 'show', u, '-p', 'MainPID', '--value']) != '0' for u in UNITS):
        raise RuntimeError('First reliable-session release requires a frozen maintenance window; pre-P2 writers must remain stopped after migration')
    call(['/usr/local/sbin/agentic-mainland-backup', '--locked'], pass_fds=(9,), timeout=1800)
    files = [Path('/etc/systemd/system') / (u + '.service.d/98-versioned-release.conf') for u in UNITS]
    previous = {path: path.read_bytes() if path.exists() else None for path in files}
    previous_current = os.readlink(current) if current.is_symlink() else None
    changed = False
    def restore():
        for path, data in previous.items():
            if data is None: path.unlink(missing_ok=True)
            else: path.write_bytes(data)
        if previous_current:
            temp = BASE / 'current.restore'
            temp.unlink(missing_ok=True)
            temp.symlink_to(previous_current, target_is_directory=True)
            temp.replace(current)
        else:
            current.unlink(missing_ok=True)
        call(['systemctl', 'daemon-reload'])
        call(['systemctl', 'restart', *UNITS])
        if not healthy(): raise RuntimeError('Rollback readiness check failed')
        print('WEB_ROLLBACK_OK', flush=True)
    try:
        changed = True
        call(['systemctl', 'stop', *UNITS])
        atomic_text(files[0], f'[Service]\nWorkingDirectory={platform}/backend\nExecStart=\nExecStart={python} -m uvicorn app.main:app --host 127.0.0.1 --port 8080\n')
        start = release / 'student-start.sh'
        start.write_text('#!/bin/bash\nset -eu\nexport STUDENT_DYNAMIC_PILOT_SCOPES="[]"\nexport STUDENT_DATABASE_URL="postgresql://student:${STUDENT_DB_PASSWORD}@127.0.0.1:55432/education"\n'
                         f'exec {student}/.venv/bin/python apps/start.py --no-browser --host 127.0.0.1 --port 8000\n')
        start.chmod(0o755)
        atomic_text(files[1], f'[Service]\nWorkingDirectory={student}\nExecStart=\nExecStart={start}\n')
        temp = BASE / 'current.new'
        temp.unlink(missing_ok=True)
        temp.symlink_to(release, target_is_directory=True)
        temp.replace(current)
        call(['systemctl', 'daemon-reload'])
        call(['systemctl', 'start', *UNITS])
        if not healthy(): raise RuntimeError('New web release failed health check')
    except BaseException:
        if changed:
            recover(restore, lambda: call(['systemctl', 'stop', *UNITS]), compatible)
        raise
    print('WEB_DEPLOY_OK', sha, flush=True)


if __name__ == '__main__':
    def interrupt(signum, frame): raise RuntimeError('Interrupted')
    signal.signal(signal.SIGTERM, interrupt)
    signal.signal(signal.SIGINT, interrupt)
    try: deploy()
    except Exception as error:
        print('WEB_DEPLOY_FAILED:', type(error).__name__, str(error), file=sys.stderr)
        sys.exit(1)
