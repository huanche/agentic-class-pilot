#!/bin/bash
set -euo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ORIGINAL="${SSH_ORIGINAL_COMMAND:-}"

case "$ORIGINAL" in
  web-prepare)
    exec /usr/bin/sudo -n /usr/local/sbin/agentic-mainland-ci-root web-prepare
    ;;
  teacher-seed-baseline)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root seed-baseline
    ;;
  teacher-prepare)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root prepare
    ;;
  teacher-media-state|teacher-media-prepare)
    exec /usr/bin/sudo -n /usr/local/sbin/agentic-mainland-ci-root "$ORIGINAL"
    ;;
  teacher-check)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root check
    ;;

  image-upload)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root upload
    ;;

  *)
    if [[ "$ORIGINAL" =~ ^web-deploy-v2\ ([0-9a-f]{40})\ ([0-9a-f]{64})$ ]]; then
      printf '%s\n%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" | \
        /usr/bin/sudo -n /usr/local/sbin/agentic-mainland-ci-root web-deploy-v2
      exit $?
    fi
    if [[ "$ORIGINAL" =~ ^teacher-deploy-v3\ (main-[0-9a-f]{7})\ ([0-9a-f]{40})\ ([0-9a-f]{40})$ ]]; then
      printf '%s\n' "${BASH_REMATCH[@]:1}" | \
        /usr/bin/sudo -n /usr/local/sbin/agentic-mainland-ci-root teacher-deploy-v3
      exit $?
    fi
    if [[ "$ORIGINAL" =~ ^teacher-deploy\ (main-[0-9a-f]{7})$ ]]; then
      TAG="${BASH_REMATCH[1]}"

      exec /usr/bin/sudo -n \
        /usr/local/sbin/agentic-mainland-ci-root \
        deploy <<< "$TAG"
    fi

    echo "SSH 命令不在允许列表中" >&2
    exit 64
    ;;
esac
