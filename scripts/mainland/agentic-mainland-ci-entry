#!/bin/bash
set -euo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ORIGINAL="${SSH_ORIGINAL_COMMAND:-}"

case "$ORIGINAL" in
  web-prepare)
    exec /usr/bin/sudo -n /usr/local/sbin/agentic-mainland-ci-root web-prepare
    ;;
  teacher-seed-baseline)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root seed-baseline
    ;;
  teacher-prepare)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root prepare
    ;;
  teacher-check)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root check
    ;;

  image-upload)
    exec /usr/bin/sudo -n \
      /usr/local/sbin/agentic-mainland-ci-root upload
    ;;

  *)
    if [[ "$ORIGINAL" =~ ^web-deploy\ ([0-9a-f]{40})$ ]]; then
      exec /usr/bin/sudo -n /usr/local/sbin/agentic-mainland-ci-root web-deploy <<< "${BASH_REMATCH[1]}"
    fi
    if [[ "$ORIGINAL" =~ ^teacher-deploy\ (main-[0-9a-f]{7})$ ]]; then
      TAG="${BASH_REMATCH[1]}"

      exec /usr/bin/sudo -n \
        /usr/local/sbin/agentic-mainland-ci-root \
        deploy <<< "$TAG"
    fi

    echo "SSH 命令不在允许列表中" >&2
    exit 64
    ;;
esac
