#!/usr/bin/python3
"""Pull one verified TCR image; credentials exist only in a temporary root directory."""
import fcntl
import json
import os
from pathlib import Path
import re
import signal
import shutil
import subprocess
import sys
import tempfile

REPOSITORY = 'ccr.ccs.tencentyun.com/agentedu-mainland/agentic-teacher'
STATE = Path('/var/lib/agentic-class-pilot/prepared-images')


def run():
    if os.geteuid() != 0:
        raise RuntimeError('Root required')
    os.umask(0o077)
    # Forced-command callers cannot select a registry, filesystem path or executable.
    payload = sys.stdin.buffer.read(16385)
    if len(payload) > 16384:
        raise RuntimeError('Request too large')
    request = json.loads(payload)
    tag, expected = request['tag'], request['image_id']
    if not re.fullmatch(r'main-[0-9a-f]{7}', tag):
        raise RuntimeError('Invalid tag')
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', expected):
        raise RuntimeError('Invalid image ID')
    username, password = request['username'], request['password']
    if not isinstance(username, str) or not re.fullmatch(r'[A-Za-z0-9_@.+:-]{1,256}', username):
        raise RuntimeError('Invalid username')
    if not isinstance(password, str) or not 1 <= len(password) <= 8192 or '\n' in password:
        raise RuntimeError('Invalid password')
    if shutil.disk_usage('/var/lib/docker').free < 10 * 1024**3:
        raise RuntimeError('Insufficient disk space')
    image = REPOSITORY + ':' + tag
    seed = sys.argv[1:] == ['--seed-baseline']
    if sys.argv[1:] and not seed:
        raise RuntimeError('Invalid mode')
    if seed and (tag != 'main-df839c6' or expected !=
                 'sha256:ff22e32dbb0c0b31cd1ca5edd8447f68238a23016b4fe18a40e3e630caeded9d'):
        raise RuntimeError('Seeding is restricted to the verified migration baseline')
    with open('/run/lock/agentic-teacher-deploy.lock', 'a') as lock:
        # The forced-command wrapper bounds the total wait/pull time.
        print('Waiting for the backup/deployment lock', flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
        with tempfile.TemporaryDirectory(prefix='agentic-tcr-', dir='/run') as config:
            docker = ['/usr/bin/docker', '--config', config]
            login = subprocess.run(docker + ['login', 'ccr.ccs.tencentyun.com', '--username', username,
                                             '--password-stdin'], input=password.encode(),
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
            if login.returncode:
                raise RuntimeError('TCR login failed (credential output suppressed)')
            print('TCR login successful; temporary credentials only', flush=True)
            if seed:
                source = 'zmzm1443/agentic-teacher:main-df839c6'
                actual = subprocess.check_output(['/usr/bin/docker', 'image', 'inspect', '--format', '{{.Id}}', source]).decode().strip()
                if actual != expected:
                    raise RuntimeError('Local baseline ID mismatch')
                subprocess.run(['/usr/bin/docker', 'tag', source, image], check=True)
                print('Seeding the verified baseline from mainland; no container changes', flush=True)
                subprocess.run(docker + ['push', image], check=True, timeout=600)
            subprocess.run(docker + ['pull', '--platform', 'linux/amd64', image], check=True, timeout=900)
        metadata = json.loads(subprocess.check_output(['/usr/bin/docker', 'image', 'inspect', image]))[0]
        if metadata['Id'] != expected:
            raise RuntimeError('Image ID mismatch; deployment not authorized')
        digests = [d for d in metadata.get('RepoDigests', []) if d.startswith(REPOSITORY + '@sha256:')]
        if not digests:
            raise RuntimeError('Missing TCR repository digest')
        STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
        record = STATE / (tag + '.json')
        temp = STATE / (tag + '.tmp')
        temp.write_text(json.dumps({'image': image, 'id': expected, 'digest': digests[0]}) + '\n')
        temp.replace(record)
        print('TCR_PREPARE_OK', image, expected, digests[0], flush=True)
        print('No container was started or replaced; temporary credentials removed', flush=True)


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise RuntimeError('Interrupted; removing temporary registry credentials')

    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        run()
    except Exception as error:
        # Never print the request, credentials or login process output.
        print('TCR_PREPARE_FAILED:', type(error).__name__, file=sys.stderr)
        sys.exit(1)
