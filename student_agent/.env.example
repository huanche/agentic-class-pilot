# 学生 Agent 环境变量模板
# 复制为 .env.local 并填入个人模型配置；共享身份/数据库配置由平台本地启动入口注入。
# 真实密钥不要提交到仓库。

# --- 平台集成（apps/integration/config.py 读取）---
# 平台内部 API 基址（前缀 /api/v1）
PLATFORM_AUTH_URL=http://127.0.0.1:8080/api/v1
# 服务间密钥（= 平台 .env 中的 STUDENT_SERVICE_KEY）
STUDENT_SERVICE_KEY=change-me-64-hex-chars
# 凭证签名密钥（= 平台 .env 中的 STUDENT_TOKEN_SIGNING_KEY；不配则回落 STUDENT_SERVICE_KEY）
STUDENT_TOKEN_SIGNING_KEY=change-me-64-hex-chars
# 学情数据库（student 角色，student schema）
STUDENT_DATABASE_URL=postgresql://student:change-me@127.0.0.1:55432/education
STUDENT_DATABASE_SCHEMA=student
# 演示模式：true 时跳过平台校验与数据库写入（仅限本地演示，正式环境必须为 false）
STUDENT_DEMO_MODE=false

# --- 大模型对话（可选，不配则使用内置提示流程）---
# AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENT_LLM_API_KEY=change-me
# AGENT_LLM_MODEL=deepseek-v4-flash
