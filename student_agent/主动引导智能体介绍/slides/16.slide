    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F2E5C' }}>五大板块：每个文件归谁管</Text>
      <Text style={{ fontSize: 15, color: '#64748B', marginTop: 6 }}>仓库 = Markdown 规则 + JSON 配置 + 编排器代码，不含前端、不含 n8n</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', top: 128, left: 64, right: 64, bottom: 56, flexDirection: 'row', gap: 24 }}>
