          ],
          [
            { text: 'lesson-data/segments/seg-XXX.json', textStyle: { bold: true, color: '#1B4F9C', fontSize: 12 } },
            '每个片段讲什么，order 定顺序，绑定 KP 编号',
            '引导学习阶段逐段驱动：active_segment_id 指向哪段讲哪段',
          ],
          [
            { text: 'stages/<阶段>/questions · rubric · prompt.md', textStyle: { bold: true, color: '#1B4F9C', fontSize: 12 }, cellStyle: { background: { color: '#E8F0FB' } } },
