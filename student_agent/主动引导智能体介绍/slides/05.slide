<Slide style={{ width: '1280px', height: '720px', padding: 0, background: '#FFFFFF' }}>
  <Box style={{ position: 'absolute', top: 36, left: 64, right: 64, flexDirection: 'row', gap: 16 }}>
    <Box style={{ width: 8, height: 40, background: '#1B4F9C', borderRadius: 2, marginTop: 4 }} />
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F2E5C' }}>逐幕体验：学生做什么、AI 做什么、星级怎么变</Text>
      <Text style={{ fontSize: 15, color: '#64748B', marginTop: 6 }}>星级只升不降 · 5 星只能由正式考核给出 · 学生说「我懂了」不是证据</Text>
    </Box>
  </Box>
  <Box style={{ position: 'absolute', top: 128, left: 64, right: 64, bottom: 56, gap: 14 }}>
    <Table
      style={{ width: '100%', height: 350 }}
