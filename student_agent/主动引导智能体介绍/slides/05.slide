        ],
        [
          { text: '引导学习', textStyle: { bold: true, color: '#1B4F9C' }, cellStyle: { background: { color: '#E8F0FB' } } },
          { text: '听讲解、被主动提问，按片段逐段推进', cellStyle: { background: { color: '#E8F0FB' } } },
          { text: '按 segments/seg-XXX.json 逐段讲解，讲完即记「已接触」', cellStyle: { background: { color: '#E8F0FB' } } },
          { text: '0 → 1 星（AI 讲过即记，不讲不记）', textStyle: { color: '#B87700', bold: true }, cellStyle: { background: { color: '#E8F0FB' } } },
        ],
        [
          { text: '复述与讨论', textStyle: { bold: true, color: '#1B4F9C' } },
