          '退居协助：提示「请老师主导」+ 计时，到点切幕',
          '星级不变，只记综合表现快照',
        ],
        [
          { text: '收尾 ending', textStyle: { bold: true, color: '#1B4F9C' }, cellStyle: { background: { color: '#E8F0FB' } } },
          { text: '收到总结与遗留问题清单', cellStyle: { background: { color: '#E8F0FB' } } },
