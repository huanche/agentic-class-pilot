# 复制本文件为 .env.local 后填写真实值（.env.local 已进 .gitignore，不会提交）
#
# 三个变量全部填齐，teach 节点才会改用真实大模型；
# 缺任意一个，teach 走确定性降级脚本，整张图照样跑完整节课。

# DeepSeek
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=sk-在这里填你的Key
AGENT_LLM_MODEL=deepseek-chat

# 其他 OpenAI 兼容端点（把上面三行注释掉，改用下面任一组即可）
# —— 通义千问（阿里云百炼）
# AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_LLM_MODEL=qwen-plus
#
# —— 智谱 GLM
# AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENT_LLM_MODEL=glm-4-flash
#
# —— OpenAI
# AGENT_LLM_BASE_URL=https://api.openai.com/v1
# AGENT_LLM_MODEL=gpt-4o-mini
