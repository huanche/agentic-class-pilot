# 复制本文件为 .env.local 后填写真实值（.env.local 已进 .gitignore，不会提交）
#
# 三个变量全部填齐，teach 节点才会改用真实大模型；
# 缺任意一个，teach 走确定性降级脚本，整张图照样跑完整节课。

# DeepSeek
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=sk-在这里填你的Key
AGENT_LLM_MODEL=deepseek-chat

# 其他 OpenAI 兼容端点（把上面三行注释掉，改用下面任一组即可）
# —— 通义千问（阿里云百炼）
# AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_LLM_MODEL=qwen-plus
#
# —— 智谱 GLM
# AGENT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AGENT_LLM_MODEL=glm-4-flash
#
# —— OpenAI
# AGENT_LLM_BASE_URL=https://api.openai.com/v1
# AGENT_LLM_MODEL=gpt-4o-mini

# 课前规划 AI（ingest 生成 lesson-plan 时用）。可选：
# 三个都填齐才走 AI 决定阶段/时长，缺任意一个走确定性规则兜底。
# 可与上面的教学 AI 分开配，用更便宜/快的模型。
PLANNER_LLM_BASE_URL=https://api.deepseek.com/v1
PLANNER_LLM_API_KEY=sk-在这里填你的Key
PLANNER_LLM_MODEL=deepseek-chat

# --- 跨域部署（默认留空 = 仅本机调试） -----------------------------------------
# 跨域访问学生端 API 时（前端与 API 不同源），设为真实来源的正则，多个用 | 连接。
# 例：AGENT_CORS_ORIGIN_REGEX=https://(www\.)?example\.com$
#AGENT_CORS_ORIGIN_REGEX=
# 跨域携带登录 Cookie 必须设 AGENT_COOKIE_SAMESITE=none，且浏览器要求 Secure，
# 即同时设 AGENT_COOKIE_SECURE=1（要求 HTTPS）。同源部署保持默认（lax）即可。
#AGENT_COOKIE_SAMESITE=lax
#AGENT_COOKIE_SECURE=0
# 会话签名密钥。不设则每次重启随机生成（重启后所有登录态失效），服务器上建议固定。
#AGENT_SESSION_SECRET=
