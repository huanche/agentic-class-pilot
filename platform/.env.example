# 平台后端环境变量模板
# 复制为 .env 并填入真实值；或直接运行 scripts/setup_local.py 自动生成本机配置。
# 真实密钥不要提交到仓库。

# --- 应用基础 ---
PROJECT_NAME=AI Education Platform
SECRET_KEY=change-me-64-hex-chars
FRONTEND_HOST=http://localhost:8080
FASTAPI_ENV=development
ENVIRONMENT=development

# --- 数据库（platform 角色，public schema）---
DATABASE_URL=postgresql://platform:change-me@127.0.0.1:55432/education
POSTGRES_PASSWORD=change-me

# --- 初始管理员 ---
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=change-me

# --- 邮件（本地开发用 Mailpit）---
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_TLS=false
EMAILS_FROM_EMAIL=noreply@example.com

# --- 教师端集成 ---
TEACHER_DB_PASSWORD=change-me
TEACHER_SERVICE_KEY=change-me-64-hex-chars
TEACHER_URL=http://127.0.0.1:3200
# legacy keeps the existing query; shadow compares the teacher API; api uses it.
# Switch to api only after shadow results and failure behavior have been checked.
TEACHER_PUBLICATION_READ_MODE=legacy
TEACHER_COURSE_PROVISION_MODE=legacy
TEACHER_ANALYTICS_READ_MODE=legacy

# --- 对象存储凭据（独立生成，不再复用数据库密码；问题6.4）---
MINIO_ROOT_PASSWORD=change-me

# --- 学生端集成（原脚本缺失、现已补齐）---
STUDENT_SERVICE_KEY=change-me-64-hex-chars
STUDENT_KNOWLEDGE_ENQUEUE_MODE=legacy
STUDENT_ANALYTICS_READ_MODE=legacy
# 凭证签名专用密钥（与通道认证分离；不配则回落 STUDENT_SERVICE_KEY 并告警）
STUDENT_TOKEN_SIGNING_KEY=change-me-64-hex-chars
STUDENT_DATABASE_URL=postgresql://student:change-me@127.0.0.1:55432/education

# --- 对象存储（MinIO）---
COURSE_OBJECT_STORAGE_MODE=minio
COURSE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:59000
COURSE_OBJECT_STORAGE_REGION=us-east-1
COURSE_OBJECT_STORAGE_BUCKET=agentedu-course-files
COURSE_OBJECT_STORAGE_ACCESS_KEY=agentedu
COURSE_OBJECT_STORAGE_SECRET_KEY=change-me
COURSE_OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- 平台自地址 / 内嵌 Agent ---
PLATFORM_URL=http://127.0.0.1:8080
EMBEDDED_AGENTS_ENABLED=false
LLM_API_KEY=local-disabled-placeholder

# --- 可选：LangGraph checkpoint 连接池（有默认值，可不填）---
# CHECKPOINT_POOL_SIZE=4
