agenticclasspilot.com {
  encode zstd gzip

  # Stable public prefixes. The upstream services keep their native paths,
  # which keeps this gateway independent from their business code.
  handle /teacher {
    redir * / 302
  }
  handle_path /teacher/* {
    reverse_proxy host.docker.internal:3200
  }
  handle /student-agent/app {
    redir * /app?{query} 302
  }
  handle /app* {
    reverse_proxy host.docker.internal:8000
  }

  # Next.js emits root-level assets and some root-level page links. These
  # routes are unambiguous in the current platform topology.
  handle /_next/* {
    reverse_proxy host.docker.internal:3200
  }
  # Public static assets of the teacher agent (agent avatars etc.).
  handle /avatars/* {
    reverse_proxy host.docker.internal:3200
  }
  handle /mentra-icon.svg {
    redir * /brand-mark.png 302
  }
  handle /brand-mark.png {
    redir * /app/brand-mark.png 302
  }
  handle /icon.svg {
    redir * /brand-mark.png 302
  }
  handle /favicon.ico {
    redir * /brand-mark.png 302
  }
  handle /apple-icon.png {
    redir * /brand-mark.png 302
  }
  handle /mentra-logo.svg {
    redir * /brand-mark.png 302
  }
  handle /logo-horizontal.png {
    reverse_proxy host.docker.internal:3200
  }
  handle /teacher-workspace* {
    reverse_proxy host.docker.internal:3200
  }
  handle /course-space* {
    reverse_proxy host.docker.internal:3200
  }
  handle /classroom-player* {
    reverse_proxy host.docker.internal:3200
  }
  # Native teacher-app page paths used by internal router.push calls; without
  # these the platform SPA fallback answers and shows its 404 view.
  handle /classes* {
    reverse_proxy host.docker.internal:3200
  }
  handle /settings* {
    reverse_proxy host.docker.internal:3200
  }
  handle /classroom* {
    reverse_proxy host.docker.internal:3200
  }
  handle /prepare* {
    reverse_proxy host.docker.internal:3200
  }
  handle /review* {
    reverse_proxy host.docker.internal:3200
  }
  handle /generation-preview* {
    reverse_proxy host.docker.internal:3200
  }

  # API routing by path prefix only. A previous Referer-based matcher
  # (^http://localhost:8088/...) silently broke after the domain migration:
  # teacher API calls fell through to the platform and 404'd. Ownership is
  # disjoint: platform owns /api/v1/*, the student agent owns /api/session/*,
  # and every other /api/* path is teacher-agent surface (generate,
  # classroom-media, course-space, classes, server-providers, access-code, ...).
  handle /api/v1/* {
    reverse_proxy host.docker.internal:8080
  }
  handle /api/session/* {
    reverse_proxy host.docker.internal:8000
  }
  handle /api/* {
    reverse_proxy host.docker.internal:3200
  }

  handle {
    reverse_proxy host.docker.internal:8080
  }
}
