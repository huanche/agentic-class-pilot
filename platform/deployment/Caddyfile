{$APP_DOMAIN} {
  encode zstd gzip
  handle /api/* {
    reverse_proxy platform-api:8000
  }
  handle /teacher/* {
    reverse_proxy teacher-agent:3200
  }

  # The PPTX importer is loaded by the teacher from a root-level URL.
  handle /vendor/maic-importer/* {
    reverse_proxy teacher-agent:3200
  }
  handle {
    reverse_proxy platform-api:8000
  }
}
