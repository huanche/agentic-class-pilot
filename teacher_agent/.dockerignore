# dependencies
node_modules
# nested workspace package node_modules (packages/@openmaic/*): shipping the
# host's pnpm symlinks into the build context lets `COPY . .` clobber the
# deps-stage's Linux links — module resolution in dist/ then breaks.
**/node_modules
.pnpm-store

# build output
.next
out
build
dist

# git
.git
.gitignore

# IDE
.idea
.vscode

# env & secrets
.env*
!.env.example
server-providers*.yml

# misc
assets
*.md
*.pdf
*.pem
.DS_Store
.vercel
coverage
logs
data
docs
.claude

# isolated MP4 render service — built as its own image (render-service/Dockerfile),
# never part of the main app image.
render-service
